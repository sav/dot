;;; vars.el -*- lexical-binding: t; -*-

(defvar doom-theme-style 'dark
  "Controls the style of Emacs themes.

Possible values are:
- 'dark  – use the dark variant of the theme.
- 'light – use the light variant of the theme.")

(defvar doom-font-family "Iosevka"
  "Default font family.")

(defvar doom-serif-font-family "Ioveka Slab"
  "Default serif font family.")

(defvar doom-variable-pitch-font-family "Open Sans"
  "Default variable pitch font family.")

(defvar doom-symbol-font-family "FontAwesome"
  "Default symbol font family.")

(defvar doom-font-size '14
  "Default font size (in points).

This value is typically used when constructing `doom-font`, which
combines the font family and size into a full specification.")

(defvar doom-font-weight 'regular
 "Default font weight.

Common values include:
- 'regular
- 'light
- 'medium
- 'semi-bold")

